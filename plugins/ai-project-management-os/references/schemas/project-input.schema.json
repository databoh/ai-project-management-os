{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/databoh/ai-project-management-os/schemas/project-input.schema.json",
  "title": "AI PM OS project initialization input",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "target", "projectType", "mode", "language"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "target": {"type": "string", "minLength": 1},
    "projectType": {
      "type": "string",
      "enum": ["new-product", "client-project", "existing-product", "feature", "internal-automation", "other"]
    },
    "mode": {"type": "string", "enum": ["beginner", "guided", "expert"]},
    "language": {"type": "string", "minLength": 2, "maxLength": 20},
    "domain": {"type": "string", "maxLength": 120},
    "problem": {"type": "string", "maxLength": 4000},
    "targetUsers": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "maxItems": 30},
    "knownConstraints": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "maxItems": 50},
    "sourceMaterials": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "maxItems": 50},
    "implementationScope": {
      "type": "string",
      "enum": ["planning-only", "planning-and-delivery"]
    },
    "initializeGit": {"type": "boolean"}
  }
}
