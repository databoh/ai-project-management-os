{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/databoh/ai-project-management-os/schemas/assumptions.schema.json",
  "title": "AI PM OS assumptions register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "assumptions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "projectId": {"type": "string"},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "owner", "impact", "validationPlan"],
        "properties": {
          "id": {"type": "string", "pattern": "^A-[0-9]{3,}$"},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "validated", "invalid", "retired"]},
          "owner": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "validationPlan": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
